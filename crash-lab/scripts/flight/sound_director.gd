class_name SoundDirector
extends Node3D
## All of the flight's sound, positional (the camera is the listener):
##   - loops driven by live state: each engine's roar, fan tone and
##     afterburner from its spool, airflow from airspeed, tyre roll, metal or
##     soil scraping at FxPool's scrape points, fire roar at each fire;
##   - one-shots on crash events from a small voice pool: impact thuds,
##     clangs and crunches scaled by the energy, tearing metal on joint breaks
##     and cracks, panel clatter, tyre bursts, fuel explosions, touchdowns.
## The sounds themselves are generated by tools/gen_sounds.gd. During the
## replay everything is silent (no events are raised there).

const BANK := "res://assets/sounds/%s.res"
const ONESHOT_VOICES := 12
## Shortest gap between impact sounds from one part, and between panel clatters.
const IMPACT_GAP := 0.15
const CLATTER_GAP := 0.12

var _aircraft: Aircraft
var _director: CrashDirector
var _recorder: CrashRecorder
var _streams: Dictionary = {}

var _roar: Array[AudioStreamPlayer3D] = []
var _fan: Array[AudioStreamPlayer3D] = []
var _burner: Array[AudioStreamPlayer3D] = []
var _wind: AudioStreamPlayer3D
var _tyres: AudioStreamPlayer3D
var _scrape: Array[AudioStreamPlayer3D] = []
var _scrape_paved: PackedByteArray = PackedByteArray()
var _fire: Array[AudioStreamPlayer3D] = []
var _voices: Array[AudioStreamPlayer3D] = []
var _next_voice: int = 0
var _last_hit: PackedFloat32Array = PackedFloat32Array()
var _last_clatter: float = -10.0
var _gear_down: PackedByteArray = PackedByteArray()
var _clock: float = 0.0
var _muted: bool = false
var _size: float = 1.0


func setup(aircraft: Aircraft, director: CrashDirector, recorder: CrashRecorder) -> void:
	_aircraft = aircraft
	_director = director
	_recorder = recorder
	# Sound carries further from a bigger aircraft.
	_size = clampf(aircraft.def.wing_span / 35.0, 0.6, 2.2)
	for e: EngineUnit in aircraft.engines:
		var roar := _loop("jet_roar", 22.0 * _size)
		var fan := _loop("fan_tone", 16.0 * _size)
		e.part.add_child(roar)
		e.part.add_child(fan)
		roar.position = e.local_pos + e.local_dir * 3.0
		fan.position = e.local_pos - e.local_dir * 1.0
		_roar.append(roar)
		_fan.append(fan)
		if e.def.afterburner_thrust > e.def.max_thrust:
			var ab := _loop("afterburner", 30.0)
			e.part.add_child(ab)
			ab.position = e.local_pos + e.local_dir * 4.0
			_burner.append(ab)
		else:
			_burner.append(null)
	_wind = _loop("wind_high", 18.0 * _size)
	aircraft.root_part.add_child(_wind)
	_tyres = _loop("tyre_roll", 10.0 * _size)
	aircraft.root_part.add_child(_tyres)
	for k: int in FxPool.SCRAPE_SLOTS:
		var s := _loop("scrape_metal", 18.0 * _size)
		add_child(s)
		_scrape.append(s)
		_scrape_paved.append(1)
	for i: int in director.fx.max_fires:
		var f := _loop("fire_roar", 20.0 * _size)
		add_child(f)
		_fire.append(f)
	for i: int in ONESHOT_VOICES:
		var v := AudioStreamPlayer3D.new()
		v.name = "Voice%d" % i
		v.max_distance = 4000.0
		v.attenuation_filter_cutoff_hz = 9000.0
		add_child(v)
		_voices.append(v)
	_last_hit.resize(aircraft.parts.size())
	_last_hit.fill(-10.0)
	_gear_down.resize(aircraft.gears.size())
	_gear_down.fill(1)
	aircraft.part_impacted.connect(_on_impact)
	aircraft.part_detached.connect(_on_detached)
	aircraft.part_cracked.connect(_on_cracked)
	aircraft.piece_shed.connect(_on_piece_shed)
	aircraft.tyre_burst.connect(_on_tyre_burst)
	aircraft.fire_started.connect(_on_fire_started)


func _stream(key: String) -> AudioStream:
	if not _streams.has(key):
		_streams[key] = load(BANK % key)
	return _streams[key]


func _loop(key: String, unit_size: float) -> AudioStreamPlayer3D:
	var p := AudioStreamPlayer3D.new()
	p.name = key
	p.stream = _stream(key)
	p.unit_size = unit_size
	p.max_distance = 5000.0
	p.volume_db = -80.0
	p.attenuation_filter_cutoff_hz = 9000.0
	return p


## Fades a loop toward `level` (0..1) at `pitch`, starting or stopping it.
func _drive(p: AudioStreamPlayer3D, level: float, pitch: float) -> void:
	if p == null:
		return
	if _muted:
		level = 0.0
	var on := level > 0.01
	if on and not p.playing:
		# Random start points so identical loops do not phase against each other.
		p.play(randf() * 0.9)
	elif not on and p.playing:
		p.stop()
		return
	if on:
		p.volume_db = linear_to_db(level)
		p.pitch_scale = clampf(pitch, 0.3, 3.5)


func _process(delta: float) -> void:
	if _aircraft == null:
		return
	_clock += delta
	_muted = _recorder != null and _recorder.playing
	var tel := _aircraft.telemetry
	for i: int in _aircraft.engines.size():
		var e := _aircraft.engines[i]
		var spool := e.spool
		_drive(_roar[i], spool * (0.35 + 0.65 * spool), 0.75 + 0.45 * spool)
		_drive(_fan[i], pow(spool, 1.5) * 0.45, 0.45 + 0.75 * spool)
		_drive(_burner[i], e.afterburner, 0.9 + 0.2 * e.afterburner)
	var speed := _aircraft.root_part.linear_velocity.length()
	_drive(_wind, clampf((speed - 25.0) / 220.0, 0.0, 0.7), 0.7 + speed / 400.0)
	var rolling := 0.0
	for g: int in _aircraft.gears.size():
		var gear := _aircraft.gears[g]
		if gear.on_ground and gear.part.joint != null:
			rolling = maxf(rolling, clampf(gear.ground_speed / 70.0, 0.0, 1.0))
		# Touchdown: the tyres spin up with a chirp and the strut thumps.
		var down := 1 if gear.on_ground else 0
		if down == 1 and _gear_down[g] == 0 and gear.ground_speed > 15.0:
			var at := gear.contact
			_play("chirp", at, clampf(gear.ground_speed / 70.0, 0.3, 1.0), 1.0)
			_play("strut_thump", at, 0.8, 1.0)
		_gear_down[g] = down
	_drive(_tyres, rolling * 0.5, 0.8 + rolling * 0.5)
	var fx := _director.fx
	for k: int in FxPool.SCRAPE_SLOTS:
		var p := _scrape[k]
		if fx.scrape_active(k):
			var paved := fx.scrape_paved[k]
			if paved != _scrape_paved[k]:
				# Metal on concrete grinds; on grass it is a dull ploughing rumble.
				_scrape_paved[k] = paved
				p.stream = _stream("scrape_metal" if paved == 1 else "scrape_soil")
			p.global_position = fx.scrape_pos[k]
			_drive(p, 0.35 + 0.65 * fx.scrape_rate[k], 0.8 + 0.4 * fx.scrape_rate[k])
		else:
			_drive(p, 0.0, 1.0)
	for i: int in _fire.size():
		var source := fx.fire_source(i)
		if source != null and is_instance_valid(source.part):
			_fire[i].global_position = source.world_position()
			_drive(_fire[i], 0.4 + 0.6 * source.intensity, 1.0)
		else:
			_drive(_fire[i], 0.0, 1.0)


## A one-shot at `pos`, `level` 0..1.
func _play(key: String, pos: Vector3, level: float, pitch: float) -> void:
	if _muted or level <= 0.01:
		return
	var v := _voices[_next_voice]
	_next_voice = (_next_voice + 1) % _voices.size()
	v.stream = _stream(key)
	v.unit_size = 25.0 * _size
	v.global_position = pos
	v.volume_db = linear_to_db(clampf(level, 0.0, 1.5))
	v.pitch_scale = clampf(pitch * randf_range(0.93, 1.07), 0.3, 3.0)
	v.play()


## Energy to loudness: 10 kJ barely heard, 10 MJ full.
static func _energy_level(energy: float) -> float:
	return clampf((log(maxf(energy, 1.0)) / log(10.0) - 4.0) / 3.0, 0.0, 1.0)


func _on_impact(part: AircraftPart, world_pos: Vector3, _impulse: Vector3, energy: float) -> void:
	if _clock - _last_hit[part.index] < IMPACT_GAP:
		return
	_last_hit[part.index] = _clock
	var level := _energy_level(energy)
	if level <= 0.0:
		return
	# Heavier sections sound lower.
	var pitch := clampf(1.6 - log(part.mass) / log(10.0) * 0.25, 0.5, 1.4)
	_play("thud", world_pos, 0.4 + 0.6 * level, pitch)
	if level > 0.35:
		_play("crunch" if level > 0.6 else ("clang_a" if part.index % 2 == 0 else "clang_b"), world_pos,
				level, pitch * 1.2)


func _on_detached(part: AircraftPart, _parent: AircraftPart, load_ratio: float) -> void:
	var at := part.xf * part.anchor_local
	_play("tear_long", at, clampf(0.6 + load_ratio * 0.1, 0.6, 1.2), 1.0)
	_play("crunch", at, 0.9, 0.9)


func _on_cracked(part: AircraftPart) -> void:
	var at := part.xf * part.anchor_local
	_play("creak", at, 0.9, 0.9)
	_play("tear_short", at, 0.7, 1.0)


func _on_piece_shed(part: AircraftPart, piece: SkinPiece, _node: MeshInstance3D, _kick: float) -> void:
	if _clock - _last_clatter < CLATTER_GAP:
		return
	_last_clatter = _clock
	var at := part.xf * piece.center
	_play("debris_chunk" if piece.structure else "debris_panel", at, 0.6, 1.0)
	if randf() < 0.3:
		_play("tear_short", at, 0.5, 1.2)


func _on_tyre_burst(_gear: GearUnit, world_pos: Vector3) -> void:
	_play("explosion", world_pos, 0.7, 2.2)


func _on_fire_started(source: FireSource) -> void:
	var at := source.world_position()
	if source.part.def.fuel_kg > 0.0:
		_play("explosion", at, 1.2, 0.8)
	else:
		_play("ab_whump", at, 0.9, 1.0)
