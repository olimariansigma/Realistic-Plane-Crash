class_name StrokeFont
extends RefCounted
## A tiny single-stroke sans font for airline titles and registrations. Each
## glyph is a few polylines on a 4 x 6 grid; text becomes a list of line
## segments that airframe.gdshader draws as a distance field, so lettering is
## sharp at any size and costs no texture.

const ADVANCE := 5.6
const SPACE := 3.2

const GLYPHS := {
	"A": [[0, 0, 2, 6, 4, 0], [0.8, 2.4, 3.2, 2.4]],
	"B": [[0, 0, 0, 6, 3, 6, 4, 5, 4, 4, 3, 3, 0, 3], [3, 3, 4, 2, 4, 1, 3, 0, 0, 0]],
	"C": [[4, 5, 3, 6, 1, 6, 0, 5, 0, 1, 1, 0, 3, 0, 4, 1]],
	"D": [[0, 0, 0, 6, 2.5, 6, 4, 4.5, 4, 1.5, 2.5, 0, 0, 0]],
	"E": [[4, 6, 0, 6, 0, 0, 4, 0], [0, 3, 3, 3]],
	"F": [[4, 6, 0, 6, 0, 0], [0, 3, 3, 3]],
	"G": [[4, 5, 3, 6, 1, 6, 0, 5, 0, 1, 1, 0, 3, 0, 4, 1, 4, 3, 2.5, 3]],
	"H": [[0, 0, 0, 6], [4, 0, 4, 6], [0, 3, 4, 3]],
	"I": [[2, 0, 2, 6], [1, 6, 3, 6], [1, 0, 3, 0]],
	"J": [[4, 6, 4, 1, 3, 0, 1, 0, 0, 1]],
	"K": [[0, 0, 0, 6], [4, 6, 0, 2], [1.3, 3.3, 4, 0]],
	"L": [[0, 6, 0, 0, 4, 0]],
	"M": [[0, 0, 0, 6, 2, 3, 4, 6, 4, 0]],
	"N": [[0, 0, 0, 6, 4, 0, 4, 6]],
	"O": [[1, 0, 0, 1, 0, 5, 1, 6, 3, 6, 4, 5, 4, 1, 3, 0, 1, 0]],
	"P": [[0, 0, 0, 6, 3, 6, 4, 5, 4, 4, 3, 3, 0, 3]],
	"Q": [[1, 0, 0, 1, 0, 5, 1, 6, 3, 6, 4, 5, 4, 1, 3, 0, 1, 0], [2.5, 1.5, 4, 0]],
	"R": [[0, 0, 0, 6, 3, 6, 4, 5, 4, 4, 3, 3, 0, 3], [2, 3, 4, 0]],
	"S": [[4, 5, 3, 6, 1, 6, 0, 5, 0, 4, 1, 3, 3, 3, 4, 2, 4, 1, 3, 0, 1, 0, 0, 1]],
	"T": [[0, 6, 4, 6], [2, 6, 2, 0]],
	"U": [[0, 6, 0, 1, 1, 0, 3, 0, 4, 1, 4, 6]],
	"V": [[0, 6, 2, 0, 4, 6]],
	"W": [[0, 6, 1, 0, 2, 3, 3, 0, 4, 6]],
	"X": [[0, 0, 4, 6], [0, 6, 4, 0]],
	"Y": [[0, 6, 2, 3, 4, 6], [2, 3, 2, 0]],
	"Z": [[0, 6, 4, 6, 0, 0, 4, 0]],
	"0": [[1, 0, 0, 1, 0, 5, 1, 6, 3, 6, 4, 5, 4, 1, 3, 0, 1, 0]],
	"1": [[1, 5, 2, 6, 2, 0], [1, 0, 3, 0]],
	"2": [[0, 5, 1, 6, 3, 6, 4, 5, 4, 4, 0, 0, 4, 0]],
	"3": [[0, 5, 1, 6, 3, 6, 4, 5, 4, 4, 3, 3, 2, 3], [3, 3, 4, 2, 4, 1, 3, 0, 1, 0, 0, 1]],
	"4": [[3, 0, 3, 6, 0, 2, 4, 2]],
	"5": [[4, 6, 0, 6, 0, 3, 3, 3, 4, 2, 4, 1, 3, 0, 0, 0]],
	"6": [[4, 5, 3, 6, 1, 6, 0, 5, 0, 1, 1, 0, 3, 0, 4, 1, 4, 2, 3, 3, 0, 3]],
	"7": [[0, 6, 4, 6, 1.5, 0]],
	"8": [[1, 3, 0, 4, 0, 5, 1, 6, 3, 6, 4, 5, 4, 4, 3, 3, 1, 3, 0, 2, 0, 1, 1, 0, 3, 0, 4, 1, 4, 2, 3, 3]],
	"9": [[0, 1, 1, 0, 3, 0, 4, 1, 4, 5, 3, 6, 1, 6, 0, 5, 0, 4, 1, 3, 4, 3]],
	"-": [[0.5, 3, 3.5, 3]],
	".": [[1.8, 0, 2.2, 0]],
}


## Line segments (x0, y0, x1, y1) of `text` in glyph units (6 = cap height),
## starting at x = 0; `width` receives the total advance.
static func segments(text: String, out: PackedVector4Array) -> float:
	var x := 0.0
	for ch: String in text.to_upper():
		if ch == " ":
			x += SPACE
			continue
		var strokes: Array = GLYPHS.get(ch, [])
		for stroke: Variant in strokes:
			var pts := stroke as Array
			for k: int in range(0, pts.size() - 2, 2):
				out.append(Vector4(x + float(pts[k]), float(pts[k + 1]), x + float(pts[k + 2]), float(pts[k + 3])))
		x += ADVANCE
	return maxf(x - (ADVANCE - 4.0), 0.0)
